# Local development only. Compose has equivalent local defaults and needs no .env.
APP_ENV=development
POSTGRES_USER=recap
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=recap
# For native backend execution. Compose replaces host names with service DNS.
DATABASE_URL=postgresql://recap:local-development-only@localhost:5432/recap
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=local-minio
S3_SECRET_KEY=local-minio-development-only
S3_BUCKET=recap-private
S3_REGION=us-east-1
MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=local-minio-development-only
# Server-only Next.js variable: never use NEXT_PUBLIC_ for credentials or backend URLs.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
SESSION_TTL_DAYS=30
SECURE_COOKIES=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]